# Copy to .env and fill in required values before running Docker or local dev.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

FLASK_ENV=production
SECRET_KEY=
DATABASE_URL=postgresql://flowleads:flowleads@db:5432/flowleads
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=FlowLeads
MAILGUN_WEBHOOK_SIGNING_KEY=
EMAIL_SENDING_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
UPLOAD_DIR=/app/uploads
REDIS_URL=redis://redis:6379/0
LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=100/hour
OPENAI_API_KEY=
AI_ENRICHMENT_ENABLED=true
AI_ENRICHMENT_MODEL=gpt-4o-mini
AI_PREDICTION_MODEL=gpt-4o-mini
AI_AUTO_ENRICH_ON_CREATE=true
AI_MAX_CONCURRENT_ENRICHMENTS=3
AI_ENRICHMENT_MAX_RETRIES=2
AI_ENRICHMENT_RETRY_DELAY_SECONDS=60
AI_TOKEN_COST_PER_1K=0.00015
DASHBOARD_CACHE_SECONDS=300
CALENDAR_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
