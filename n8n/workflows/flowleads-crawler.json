      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1100,
        200
      ],
      "id": "b5f20741-a787-48c3-b349-3b2167e8e55a",
      "name": "HTTP – Fetch Oikotie Search Page",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const task = $('LOOP – Tasks').first().json;\nconst html = String($input.first()?.json?.data || $input.first()?.json?.body || '');\nlet parsed = null;\nconst m = html.match(/\"locations\"\\s*:\\s*(\\[[^\\]]*\\])/i);\nif (m && m[1]) { try { parsed = JSON.parse(m[1]); } catch (e) { parsed = null; } }\nconst locations = Array.isArray(parsed) && parsed.length\n  ? parsed.map(loc => [loc.id, loc.type, loc.name])\n  : [task.slug];\nreturn [{ json: { ...task, locations } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "id": "d1ef85d9-579e-4b83-be0e-8279a0137bf9",
      "name": "PARSE – Extract apiLocation"
    },
    {
      "parameters": {
        "url": "https://asunnot.oikotie.fi/myytavat-asunnot?cardType=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
            },
            {
              "name": "referer",
              "value": "https://asunnot.oikotie.fi/"
            },
            {
              "name": "accept-language",
              "value": "fi-FI,fi;q=0.9,en-US;q=0.8,en;q=0.7"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1540,
        200
      ],
      "id": "bc1b3f43-3317-43ea-a4e4-78b192f149c6",
      "name": "HTTP – Fetch Oikotie API Bootstrap",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const task = $('PARSE – Extract apiLocation').first().json;\nconst r = $input.first()?.json || {};\nconst html = String(r.data || r.body || '');\nconst meta = (name) => {\n  const m = html.match(new RegExp(`<meta[^>]+name=[\"']${name}[\"'][^>]+content=[\"']([^\"']+)[\"']`, 'i'));\n  return m ? m[1] : '';\n};\nconst setCookie = r.headers?.['set-cookie'] || [];\nconst cookie = Array.isArray(setCookie) ? setCookie.map(x => String(x).split(';')[0]).join('; ') : '';\nreturn [{ json: {\n  ...task,\n  cookie,\n  otaToken: meta('api-token'),\n  otaCuid: meta('cuid'),\n  otaLoaded: meta('loaded'),\n  page_in_run: 1,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "id": "8aea2b58-93ac-4518-9f2c-f1460ced55cc",
      "name": "TRANSFORM – Extract Session Cookie"
    },
    {
      "parameters": {
        "jsCode": "// Every page passes through here right before the API call, so later nodes\n// read the current page's context with $('CODE – Page Context').first().\nreturn [{ json: $input.first().json }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "id": "ebe8b041-5648-49d9-9cd4-a630e79b2c0e",
      "name": "CODE – Page Context"
    },
    {
      "parameters": {
        "url": "https://asunnot.oikotie.fi/api/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "cardType",
              "value": "100"
            },
            {
              "name": "limit",
              "value": "24"
            },
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
            },
            {
              "name": "sortBy",
              "value": "published_sort_desc"
            },
            {
              "name": "locations",
              "value": "={{ JSON.stringify($json.locations) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "cookie",
              "value": "={{$json.cookie}}"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            },
            {
              "name": "accept",
              "value": "application/json, text/plain, */*"
            },
            {
              "name": "referer",
              "value": "https://asunnot.oikotie.fi/myytavat-asunnot"
            },
            {
              "name": "ota-token",
              "value": "={{$json.otaToken}}"
            },
            {
              "name": "ota-cuid",
              "value": "={{$json.otaCuid}}"
            },
            {
              "name": "ota-loaded",
              "value": "={{$json.otaLoaded}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2200,
        200
      ],
      "id": "56b0d7e9-4f74-4b89-a6e1-80aca067b4bb",
      "name": "HTTP – Fetch Oikotie Listings API",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('CODE – Page Context').first().json;\nconst r = $input.first()?.json || {};\nlet error = '';\nif (r.error) error = typeof r.error === 'string' ? r.error : (r.error.message || JSON.stringify(r.error));\nconst cards = r.cards || r.data?.cards;\nif (!error && !Array.isArray(cards)) error = 'Unexpected Oikotie response: ' + JSON.stringify(r).slice(0, 200);\nconst listings = (Array.isArray(cards) ? cards : []).map(card => {\n  const loc = card.location || {};\n  const d = card.data || {};\n  const b = card.buildingData || card.building || {};\n  return {\n    external_id: String(card.cardId || card.id || ''),\n    url: card.url || '',\n    kaupunki: loc.city || loc.municipality || '',\n    osoite: loc.address || '',\n    hinta: d.price || '',\n    alue: d.size || d.sizeMax || '',\n    description: d.description || '',\n    published_at: card.published || d.published || card.meta?.published || null,\n    // optional: the CRM falls back to the AI analysis when these are missing\n    build_year: b.year || d.buildYear || d.year || null,\n    building_type: b.buildingType || d.buildingType || card.buildingType || null,\n  };\n});\nconst body = {\n  maakunta: ctx.maakunta,\n  mode: ctx.mode,\n  offset: Number(ctx.offset || 0),\n  page_in_run: Number(ctx.page_in_run || 1),\n  listings,\n};\nif (error) body.error = error.slice(0, 1000);\nreturn [{ json: { ctx, crm_base_url: ctx.crm_base_url, n8n_secret: ctx.n8n_secret, body } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        200
