        "url": "={{ $json.crm_base_url }}/api/v1/n8n/listings/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $json.n8n_secret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
