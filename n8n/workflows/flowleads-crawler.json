      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        200
      ],
      "id": "e07b8292-1f11-4e90-ac8b-3f98edbf697b",
      "name": "HTTP – CRM Ingest",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const { ctx } = $('CODE – Normalize Cards').first().json;\nconst r = $input.first()?.json || {};\nconst page = Number(ctx.page_in_run || 1);\n// The CRM decides: incremental stops once a page brings nothing new, the\n// full pass stops after its per-run slice; max_pages is a local safety cap.\n// Oikotie's bot protection answers 403 (captcha) or 429 when we go too fast.\n// Then the whole run stops: no more pages and no further regions this hour.\nconst err = String($('CODE – Normalize Cards').first().json.body.error || '');\nconst blocked = /(?<!\\d)(403|429)(?!\\d)|captcha/i.test(err);\nconst more = !blocked && r.continue === true && page < Number(ctx.max_pages || 1);\nreturn [{ json: { ...ctx, more, blocked, offset: Number(r.next_offset ?? (Number(ctx.offset || 0) + 24)), page_in_run: page + 1 } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        200
      ],
      "id": "1bcba17b-9f49-4f73-b4fe-1745fe087797",
      "name": "CODE – Next Page"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c08b7a7a-4665-4d95-9d76-9c7a7a86f241",
              "leftValue": "={{ $json.blocked }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
