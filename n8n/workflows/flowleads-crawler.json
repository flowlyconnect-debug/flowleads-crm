      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "44b11db4-7131-43fe-84e0-fd1a38d79d82",
      "name": "Every hour"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "id": "5a84e424-64bb-422f-89b4-e6b15f02fcf7",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4bfd3f5f-0523-4f85-97b1-c00e993d5d81",
              "name": "crm_base_url",
              "value": "https://flowleads-crm.onrender.com",
              "type": "string"
            },
            {
              "id": "59588e0d-0643-48d4-bdfa-d4e9630df1d4",
              "name": "n8n_secret",
              "value": "VAIHDA_TAHAN_N8N_MASTER_SECRET",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "id": "51ab5cf8-9bbe-48ef-b431-5c30be0ad467",
      "name": "SET – Config",
      "notes": "CRM-osoite ja sama arvo kuin Renderin N8N_MASTER_SECRET. Sama asetus on jokaisessa kolmessa workflowssa."
    },
    {
      "parameters": {
        "url": "={{ $json.crm_base_url.replace(/\\/$/, '') }}/api/v1/n8n/listings/crawl-plan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $json.n8n_secret }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "id": "49eea970-54dc-47ef-8b99-5d384624da76",
      "name": "HTTP – Get Crawl Plan",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('SET – Config').first().json;\nconst rows = ($input.first().json.tasks || []);\nreturn rows.map(r => ({ json: { ...r,  crm_base_url: String(cfg.crm_base_url || '').replace(/\\/$/, ''), n8n_secret: cfg.n8n_secret } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "id": "28544d2e-58d5-4e1f-ba4e-21cd1efb15f0",
      "name": "CODE – Split Tasks"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        100
      ],
      "id": "95428d4b-9024-4144-acb0-e13e67c2de9b",
      "name": "LOOP – Tasks",
      "notes": "Yksi tehtävä = yksi maakunta (incremental tai full-pass-viipale)."
    },
    {
      "parameters": {
        "url": "={{ 'https://asunnot.oikotie.fi/myytavat-asunnot/' + $json.slug }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "cardType",
              "value": "100"
            },
            {
              "name": "offset",
              "value": "0"
            },
            {
              "name": "limit",
              "value": "24"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36"
            },
            {
              "name": "accept-language",
              "value": "fi-FI,fi;q=0.9,en-US;q=0.8,en;q=0.7"
            },
            {
              "name": "upgrade-insecure-requests",
              "value": "1"
            },
            {
              "name": "sec-fetch-site",
              "value": "none"
            },
            {
              "name": "sec-fetch-mode",
              "value": "navigate"
            },
            {
              "name": "sec-fetch-user",
              "value": "?1"
            },
            {
              "name": "sec-fetch-dest",
              "value": "document"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1100,
        200
      ],
      "id": "2d0f2f6e-6ee7-40b7-8bb4-a6273aca1849",
      "name": "HTTP – Fetch Oikotie Search Page",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const task = $('LOOP – Tasks').first().json;\nconst html = String($input.first()?.json?.data || $input.first()?.json?.body || '');\nlet parsed = null;\nconst m = html.match(/\"locations\"\\s*:\\s*(\\[[^\\]]*\\])/i);\nif (m && m[1]) { try { parsed = JSON.parse(m[1]); } catch (e) { parsed = null; } }\nconst locations = Array.isArray(parsed) && parsed.length\n  ? parsed.map(loc => [loc.id, loc.type, loc.name])\n  : [task.slug];\nreturn [{ json: { ...task, locations } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "id": "904aca63-7e69-4e78-af11-5f481b887219",
      "name": "PARSE – Extract apiLocation"
    },
    {
      "parameters": {
        "url": "https://asunnot.oikotie.fi/myytavat-asunnot?cardType=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
            },
            {
              "name": "cookie",
              "value": "={{ ($json.headers?.['set-cookie'] || []).map(c => String(c).split(';')[0]).join('; ') }}"
            },
            {
              "name": "referer",
              "value": "https://asunnot.oikotie.fi/"
            },
            {
              "name": "accept-language",
              "value": "fi-FI,fi;q=0.9,en-US;q=0.8,en;q=0.7"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1540,
        200
      ],
      "id": "2e6d5b53-b6ac-45c0-a398-714291cb8ebf",
      "name": "HTTP – Fetch Oikotie API Bootstrap",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const task = $('PARSE – Extract apiLocation').first().json;\nconst r = $input.first()?.json || {};\nconst html = String(r.data || r.body || '');\nconst meta = (name) => {\n  const m = html.match(new RegExp(`<meta[^>]+name=[\"']${name}[\"'][^>]+content=[\"']([^\"']+)[\"']`, 'i'));\n  return m ? m[1] : '';\n};\nconst setCookie = r.headers?.['set-cookie'] || [];\nconst cookie = Array.isArray(setCookie) ? setCookie.map(x => String(x).split(';')[0]).join('; ') : '';\nreturn [{ json: {\n  ...task,\n  cookie,\n  otaToken: meta('api-token'),\n  otaCuid: meta('cuid'),\n  otaLoaded: meta('loaded'),\n  page_in_run: 1,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "id": "ac80f0a4-d903-48ba-bbce-10bf28fc678d",
      "name": "TRANSFORM – Extract Session Cookie"
    },
    {
      "parameters": {
        "jsCode": "// Every page passes through here right before the API call, so later nodes\n// read the current page's context with $('CODE – Page Context').first().\nreturn [{ json: $input.first().json }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "id": "3b35383c-8669-46c1-98ed-fda310e89273",
      "name": "CODE – Page Context"
    },
    {
      "parameters": {
        "url": "https://asunnot.oikotie.fi/api/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "cardType",
              "value": "100"
            },
            {
              "name": "limit",
              "value": "24"
            },
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
            },
            {
              "name": "sortBy",
              "value": "published_sort_desc"
            },
            {
              "name": "locations",
              "value": "={{ JSON.stringify($json.locations) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "cookie",
              "value": "={{$json.cookie}}"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            },
            {
              "name": "accept",
              "value": "application/json, text/plain, */*"
            },
            {
              "name": "referer",
              "value": "https://asunnot.oikotie.fi/myytavat-asunnot"
            },
            {
              "name": "ota-token",
              "value": "={{$json.otaToken}}"
            },
            {
              "name": "ota-cuid",
              "value": "={{$json.otaCuid}}"
            },
            {
              "name": "ota-loaded",
              "value": "={{$json.otaLoaded}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2200,
        200
      ],
      "id": "5d473649-b1ba-4e24-8e69-60950346b7aa",
      "name": "HTTP – Fetch Oikotie Listings API",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('CODE – Page Context').first().json;\nconst r = $input.first()?.json || {};\nlet error = '';\nif (r.error) error = typeof r.error === 'string' ? r.error : (r.error.message || JSON.stringify(r.error));\nconst cards = r.cards || r.data?.cards;\nif (!error && !Array.isArray(cards)) error = 'Unexpected Oikotie response: ' + JSON.stringify(r).slice(0, 200);\nconst listings = (Array.isArray(cards) ? cards : []).map(card => {\n  const loc = card.location || {};\n  const d = card.data || {};\n  return {\n    external_id: String(card.cardId || card.id || ''),\n    url: card.url || '',\n    kaupunki: loc.city || loc.municipality || '',\n    osoite: loc.address || '',\n    hinta: d.price || '',\n    alue: d.size || d.sizeMax || '',\n    description: d.description || '',\n    published_at: card.published || d.published || card.meta?.published || null,\n  };\n});\nconst body = {\n  maakunta: ctx.maakunta,\n  mode: ctx.mode,\n  offset: Number(ctx.offset || 0),\n  page_in_run: Number(ctx.page_in_run || 1),\n  listings,\n};\nif (error) body.error = error.slice(0, 1000);\nreturn [{ json: { ctx, crm_base_url: ctx.crm_base_url, n8n_secret: ctx.n8n_secret, body } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        200
      ],
      "id": "536d659e-f5f0-4dba-9360-c8700df668e4",
      "name": "CODE – Normalize Cards"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.crm_base_url }}/api/v1/n8n/listings/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $json.n8n_secret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        200
      ],
      "id": "13506b08-691b-465c-8553-bd84969c4f7f",
      "name": "HTTP – CRM Ingest",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const { ctx } = $('CODE – Normalize Cards').first().json;\nconst r = $input.first()?.json || {};\nconst page = Number(ctx.page_in_run || 1);\n// The CRM decides: incremental stops once a page brings nothing new, the\n// full pass stops after its per-run slice; max_pages is a local safety cap.\nconst more = r.continue === true && page < Number(ctx.max_pages || 1);\nreturn [{ json: { ...ctx, more, offset: Number(r.next_offset ?? (Number(ctx.offset || 0) + 24)), page_in_run: page + 1 } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        200
      ],
      "id": "06a986be-b484-4020-b840-af8f0a4458a0",
      "name": "CODE – Next Page"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e37d5cde-5fed-4916-bf66-a3c93d2c8688",
              "leftValue": "={{ $json.more }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3080,
        200
      ],
      "id": "f5657413-36f7-4f37-887b-2b95bbf53380",
      "name": "IF – More Pages"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3300,
        340
      ],
      "id": "6a6d4600-0904-46b5-bb54-4278d3f3bdbc",
      "name": "WAIT – Between Pages",
      "webhookId": "8539fc14-93b1-4ae0-8c80-994159af3480"
    }
  ],
  "pinData": {},
