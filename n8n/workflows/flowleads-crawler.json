      "id": "9d379443-f85d-4e43-968e-26f2908c8c9c",
      "name": "SET – Config",
      "notes": "CRM-osoite ja sama arvo kuin Renderin N8N_MASTER_SECRET. Sama asetus on jokaisessa kolmessa workflowssa."
    },
    {
      "parameters": {
        "url": "={{ $json.crm_base_url.replace(/\\/$/, '') }}/api/v1/n8n/listings/crawl-plan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $json.n8n_secret }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "id": "f845bcb2-a1fd-4232-b33b-7b74e70b3e44",
      "name": "HTTP – Get Crawl Plan",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('SET – Config').first().json;\nconst rows = ($input.first().json.tasks || []);\nreturn rows.map(r => ({ json: { ...r,  crm_base_url: String(cfg.crm_base_url || '').replace(/\\/$/, ''), n8n_secret: cfg.n8n_secret } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "id": "6a8c1dfb-7056-4c06-9ef6-41e5a82b96f4",
      "name": "CODE – Split Tasks"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        100
      ],
      "id": "522c6525-3d16-4eb4-8b20-b102d14c20e5",
      "name": "LOOP – Tasks",
      "notes": "Yksi tehtävä = yksi maakunta (incremental tai full-pass-viipale)."
    },
    {
      "parameters": {
        "url": "={{ 'https://asunnot.oikotie.fi/myytavat-asunnot/' + $json.slug }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "cardType",
              "value": "100"
            },
            {
              "name": "offset",
              "value": "0"
            },
            {
              "name": "limit",
              "value": "24"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36"
            },
            {
              "name": "accept-language",
              "value": "fi-FI,fi;q=0.9,en-US;q=0.8,en;q=0.7"
            },
            {
              "name": "upgrade-insecure-requests",
              "value": "1"
            },
            {
              "name": "sec-fetch-site",
              "value": "none"
            },
            {
              "name": "sec-fetch-mode",
              "value": "navigate"
            },
            {
              "name": "sec-fetch-user",
              "value": "?1"
            },
            {
              "name": "sec-fetch-dest",
              "value": "document"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1100,
        200
      ],
      "id": "190e8c9f-cc7d-43bd-adef-7485e0aa4603",
      "name": "HTTP – Fetch Oikotie Search Page",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const task = $('LOOP – Tasks').first().json;\nconst html = String($input.first()?.json?.data || $input.first()?.json?.body || '');\nlet parsed = null;\nconst m = html.match(/\"locations\"\\s*:\\s*(\\[[^\\]]*\\])/i);\nif (m && m[1]) { try { parsed = JSON.parse(m[1]); } catch (e) { parsed = null; } }\nconst locations = Array.isArray(parsed) && parsed.length\n  ? parsed.map(loc => [loc.id, loc.type, loc.name])\n  : [task.slug];\nreturn [{ json: { ...task, locations } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "id": "73c518d1-c97b-4870-ab25-c42cbec48dc3",
      "name": "PARSE – Extract apiLocation"
    },
    {
      "parameters": {
        "url": "https://asunnot.oikotie.fi/myytavat-asunnot?cardType=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
            },
            {
              "name": "cookie",
              "value": "={{ ($json.headers?.['set-cookie'] || []).map(c => String(c).split(';')[0]).join('; ') }}"
            },
            {
              "name": "referer",
              "value": "https://asunnot.oikotie.fi/"
            },
            {
              "name": "accept-language",
              "value": "fi-FI,fi;q=0.9,en-US;q=0.8,en;q=0.7"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1540,
        200
      ],
      "id": "2b0b82cc-04cf-41fc-bff1-f260c2fefdff",
      "name": "HTTP – Fetch Oikotie API Bootstrap",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const task = $('PARSE – Extract apiLocation').first().json;\nconst r = $input.first()?.json || {};\nconst html = String(r.data || r.body || '');\nconst meta = (name) => {\n  const m = html.match(new RegExp(`<meta[^>]+name=[\"']${name}[\"'][^>]+content=[\"']([^\"']+)[\"']`, 'i'));\n  return m ? m[1] : '';\n};\nconst setCookie = r.headers?.['set-cookie'] || [];\nconst cookie = Array.isArray(setCookie) ? setCookie.map(x => String(x).split(';')[0]).join('; ') : '';\nreturn [{ json: {\n  ...task,\n  cookie,\n  otaToken: meta('api-token'),\n  otaCuid: meta('cuid'),\n  otaLoaded: meta('loaded'),\n  page_in_run: 1,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "id": "ce12b4a8-2ecb-4df0-a03e-97f172b05f1a",
      "name": "TRANSFORM – Extract Session Cookie"
    },
    {
      "parameters": {
        "jsCode": "// Every page passes through here right before the API call, so later nodes\n// read the current page's context with $('CODE – Page Context').first().\nreturn [{ json: $input.first().json }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "id": "218e5e81-96e0-47d6-bfae-85d2f27ea39f",
      "name": "CODE – Page Context"
    },
    {
      "parameters": {
        "url": "https://asunnot.oikotie.fi/api/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "cardType",
              "value": "100"
            },
            {
              "name": "limit",
              "value": "24"
            },
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
            },
            {
              "name": "sortBy",
              "value": "published_sort_desc"
            },
            {
              "name": "locations",
              "value": "={{ JSON.stringify($json.locations) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "cookie",
              "value": "={{$json.cookie}}"
            },
            {
              "name": "user-agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            },
            {
              "name": "accept",
              "value": "application/json, text/plain, */*"
            },
            {
              "name": "referer",
              "value": "https://asunnot.oikotie.fi/myytavat-asunnot"
            },
            {
              "name": "ota-token",
              "value": "={{$json.otaToken}}"
            },
            {
              "name": "ota-cuid",
              "value": "={{$json.otaCuid}}"
            },
            {
              "name": "ota-loaded",
              "value": "={{$json.otaLoaded}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2200,
        200
      ],
      "id": "9f888636-a506-4b59-b90e-d239198c3461",
      "name": "HTTP – Fetch Oikotie Listings API",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('CODE – Page Context').first().json;\nconst r = $input.first()?.json || {};\nlet error = '';\nif (r.error) error = typeof r.error === 'string' ? r.error : (r.error.message || JSON.stringify(r.error));\nconst cards = r.cards || r.data?.cards;\nif (!error && !Array.isArray(cards)) error = 'Unexpected Oikotie response: ' + JSON.stringify(r).slice(0, 200);\nconst listings = (Array.isArray(cards) ? cards : []).map(card => {\n  const loc = card.location || {};\n  const d = card.data || {};\n  const b = card.buildingData || card.building || {};\n  return {\n    external_id: String(card.cardId || card.id || ''),\n    url: card.url || '',\n    kaupunki: loc.city || loc.municipality || '',\n    osoite: loc.address || '',\n    hinta: d.price || '',\n    alue: d.size || d.sizeMax || '',\n    description: d.description || '',\n    published_at: card.published || d.published || card.meta?.published || null,\n    // optional: the CRM falls back to the AI analysis when these are missing\n    build_year: b.year || d.buildYear || d.year || null,\n    building_type: b.buildingType || d.buildingType || card.buildingType || null,\n  };\n});\nconst body = {\n  maakunta: ctx.maakunta,\n  mode: ctx.mode,\n  offset: Number(ctx.offset || 0),\n  page_in_run: Number(ctx.page_in_run || 1),\n  listings,\n};\nif (error) body.error = error.slice(0, 1000);\nreturn [{ json: { ctx, crm_base_url: ctx.crm_base_url, n8n_secret: ctx.n8n_secret, body } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        200
      ],
      "id": "ce522698-cfda-4600-816a-d365d0985f47",
      "name": "CODE – Normalize Cards"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.crm_base_url }}/api/v1/n8n/listings/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $json.n8n_secret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        200
      ],
      "id": "3a2986ea-1e92-4dfa-9187-8e29efe7642d",
      "name": "HTTP – CRM Ingest",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const { ctx } = $('CODE – Normalize Cards').first().json;\nconst r = $input.first()?.json || {};\nconst page = Number(ctx.page_in_run || 1);\n// The CRM decides: incremental stops once a page brings nothing new, the\n// full pass stops after its per-run slice; max_pages is a local safety cap.\nconst more = r.continue === true && page < Number(ctx.max_pages || 1);\nreturn [{ json: { ...ctx, more, offset: Number(r.next_offset ?? (Number(ctx.offset || 0) + 24)), page_in_run: page + 1 } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        200
      ],
      "id": "7ab37343-a151-40d4-a9a8-58369fb7c4fa",
      "name": "CODE – Next Page"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a0358928-192a-4661-b7ab-d0870d59e2ba",
              "leftValue": "={{ $json.more }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3080,
        200
      ],
      "id": "505c2153-ada8-421a-b0f7-07b21788b91a",
      "name": "IF – More Pages"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3300,
        340
      ],
      "id": "2c51a6c5-5968-4c06-b435-8fcf439a643e",
      "name": "WAIT – Between Pages",
      "webhookId": "37e6304f-0464-4a2a-8f89-3d0ea1e0371b"
    }
  ],
