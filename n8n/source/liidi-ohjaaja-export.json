      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const html = $json.data || \"\";\n\n\nconst maakunta = $('Code in JavaScript').first().json.maakunta || \"\";\nconst chunkSize = Number($('Code in JavaScript').first().json.chunkSize || 100);\n\n\nconst countMatch = html.match(/:\\s*([\\d\\s]+)\\s*kpl/i);\n\nlet totalCount = 0;\n\nif (countMatch && countMatch[1]) {\n  totalCount = parseInt(countMatch[1].replace(/\\s+/g, \"\"), 10);\n}\n\nconst perPage = 24;\nconst totalPages = Math.max(1, Math.ceil(totalCount / perPage));\n\nreturn [\n  {\n    json: {\n      data: html,\n      maakunta,\n      chunkSize,\n      totalCount,\n      totalPages\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        -144
      ],
      "id": "e462e257-d6f5-4e5f-9859-12aa133ef1ea",
      "name": "Total Pages"
    },
    {
      "parameters": {
        "jsCode": "const maakunta = $json.maakunta || \"\";\nconst totalPages = Number($json.totalPages || 1);\n\nconst pages = [];\n\nfor (let page = 1; page <= totalPages; page++) {\n  pages.push({\n    json: {\n      maakunta,\n      page,\n      pageLabel: String(page)\n    }\n  });\n}\n\nreturn pages;"
      },
